{
  "name": "lanchat-ng",
  "version": "0.1.0",
  "description": "Encrypted peer-to-peer LAN chat for internal team communication (new protocol, terminal UI).",
  "type": "module",
  "bin": {
    "lanchat-ng": "dist/index.js",
    "lanchat": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "PROTOCOL.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
